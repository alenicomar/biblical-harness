{
  "name": "biblical-harness",
  "version": "0.1.0",
  "description": "Protestant/Evangelical Bible-study ecosystem for AI: harnesses over the Free Use Bible API.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alenicomar/biblical-harness.git"
  },
  "homepage": "https://github.com/alenicomar/biblical-harness#readme",
  "bugs": {
    "url": "https://github.com/alenicomar/biblical-harness/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "bin": {
    "biblical-harness": "dist/cli/main.js"
  },
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "node --test \"test/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "skills": "node src/cli/main.ts skills build",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist",
    "skills",
    "README.md",
    "LICENSE"
  ]
}
